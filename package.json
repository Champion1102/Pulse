{
  "name": "pulse",
  "version": "1.0.0",
  "description": "Pulse - real-time classroom quiz platform (SESD capstone)",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:web",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json",
    "test": "mocha",
    "test:unit": "mocha \"test/unit/**/*.test.ts\"",
    "test:integration": "mocha \"test/integration/**/*.test.ts\"",
    "load-test": "tsx scripts/load-test.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.5",
    "@types/chai": "^4.3.20",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "chai": "^4.5.0",
    "mocha": "^12.0.3",
    "motion": "^14.14.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.6",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
