# Copy to .env (or export in your shell). All optional.
PORT=3000
# Claude drafts questions when credentials are present; otherwise the offline drafter is used.
ANTHROPIC_API_KEY=
# Force the offline drafter even if a key is set (useful during the viva if Wi-Fi is bad):
# PULSE_AI_PROVIDER=offline
# Log every answer as JSON lines (example Observer):
# PULSE_ANSWER_LOG=./logs/answers.jsonl
# Set to false to start with an empty question bank:
# PULSE_SEED=false
